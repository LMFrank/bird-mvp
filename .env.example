# eBird API（用于生成鸟种 labels CSV，可选）
EBIRD_API_KEY=

# AI 服务地址（本地开发用；Docker 模式下由 docker-compose.yml 固定注入）
# 例：BIRD_AI_URL=http://localhost:8000
BIRD_AI_URL=

# HuggingFace 下载镜像（可选，默认 https://hf-mirror.com）
HF_ENDPOINT=https://hf-mirror.com

# AI 容器：无 GPU 时强制 CPU（Docker 模式下用于 ai 服务）
FORCE_CPU=

# 数据缓存与数据库位置（默认 data/cache）
CACHE_DIR=

# migrations 目录（默认 server/migrations）
MIGRATIONS_DIR=

# 后端任务并发（默认 1）
JOB_CONCURRENCY=

# AI 标签 CSV 路径（Docker 模式下用于 ai 服务）
BIRD_LABELS_PATH=
BIRD_REGION_LABELS_DIR=
BIRD_CAPTIVE_LABELS_PATH=

# 识别输入调优（默认：4096/90/9/3/多尺度 0.6,0.45）
IDENTIFY_MAX_SIZE=
IDENTIFY_JPEG_QUALITY=
IDENTIFY_CROPS_SINGLE=
IDENTIFY_CROPS_BATCH=
IDENTIFY_CROP_SCALE=
IDENTIFY_CROP_SCALES=
IDENTIFY_CROP_SCALES_SINGLE=
IDENTIFY_CROP_SCALES_BATCH=

# AI 检测、prompt 与融合消融参数
DETECT_ENABLED=1
DETECT_IMGSZ=1280
DETECT_TOP_BOXES=3
FUSION_STRATEGY=max
FUSION_ROI_WEIGHT=1.2
PROMPT_MODE=single

# 非鸟自动拒识阈值；0 表示禁用，必须用 88+12 真值集校准后才启用
NON_BIRD_MAX_SCORE=0

# 自动通过阈值（其余进入待复核；无结果为 unknown）
ACCEPT_MIN_SCORE=0.65
ACCEPT_MIN_MARGIN=0.12

# 低置信度兜底（联网，多模态大模型；设置 QWEN_API_KEY 即可启用）
# 1. Qwen (DashScope OpenAI 兼容模式；模型需支持图片输入，通常为 *vl* 系列)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen-vl-plus

# 高级：OpenAI 兼容兜底配置（可选；不填则自动用 Qwen 配置）
LLM_FALLBACK_ENABLED=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_CANDIDATES=
LLM_FALLBACK_TRIGGER_SCORE=
LLM_FALLBACK_TRIGGER_MARGIN=
